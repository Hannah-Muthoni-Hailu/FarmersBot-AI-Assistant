<FocusTextInput@TextInput>:
    on_touch_down:
        self.focus = True

# reusable background template for a "card"
<CardTemplate@BoxLayout>:
    is_login_mode: False # Controls the login/signup toggle

    # Controls when the subcounty selection, input selection and back button are shown
    show_input_type: True
    show_subcounty: True
    show_secondary: True

    send_action: lambda *args: None
    secondary_action: lambda *args: None
    open_subcounty_action: lambda *args: None
    error_message: ""
    username_label: "Enter Username:"
    password_label: "Enter Password:"
    send_text: "SEND"
    secondary_text: ""

    orientation: 'vertical'
    size_hint: None, None
    width: max(root.parent.width * 0.7, 300)
    height: max(root.parent.height * 0.8, 500)
    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
    padding: 20
    spacing: 8
    canvas.before:
        Color:
            rgba: (90/255), (150/255), (63/255), 1
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [20, 20, 20, 20] 
    
    # User name input
    Label:
        text: root.username_label
        color: 0, 0, 0, 1
        size_hint_y: None
        height: 50
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        padding_x: 35
   
    FocusTextInput:
        id: username_input
        multiline: False
        focus: True if self.collide_point(*self.parent.to_window(*self.pos)) else False
        size_hint_y: None
        height: 60
        size_hint_x: 0.8
        pos_hint: {'center_x': 0.5}

    # Spacer
    Widget:
        size_hint_y: 0.005

    # Password input
    Label:
        text: root.password_label
        color: 0, 0, 0, 1
        size_hint_y: None
        height: 50
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        padding_x: 35
   
    FocusTextInput:
        id: password_input
        multiline: False
        focus: True if self.collide_point(*self.parent.to_window(*self.pos)) else False
        size_hint_y: None
        height: 60
        size_hint_x: 0.8
        pos_hint: {'center_x': 0.5}
    
    Widget:
        size_hint_y: 0.005

    # Input type selection
    BoxLayout:
        id: input_type_container
        orientation: "vertical"
        size_hint_y: None
        height: 0 if not root.show_input_type else 100
        opacity: 0 if not root.show_input_type else 1
        disabled: not root.show_input_type
        spacing: 5

        Label:
            text: "Select your preferred input type"
            color: 0, 0, 0, 1
            size_hint_y: None
            height: 50
            text_size: self.size
            halign: 'left'
            valign: 'middle'
            padding_x: 35

        BoxLayout:
            id: input_type_row
            orientation: "horizontal"
            size_hint_y: None
            height: 50
            size_hint_x: 0.8
            pos_hint: {'center_x': 0.5}

            Label:
                text: "Audio"
                color: 0,0,0,1
            CheckBox:
                id: audio_check
                group: "input"
            Label:
                text: "Text"
                color: 0,0,0,1
            CheckBox:
                id: text_check
                group: "input"

    Widget:
        size_hint_y: 0.005
        
    MDBoxLayout:
        id: dropdown_menu
        orientation: "vertical"
        size_hint_x: 0.9
        size_hint_y: None
        height: 70 if root.show_subcounty else 0
        pos_hint: {'center_x': 0.5}
        opacity: 1 if root.show_subcounty else 0
        disabled: not root.show_subcounty
        on_touch_down:
            if self.collide_point(*args[1].pos): root.open_subcounty_action()

        MDTextField:
            id: subcounty_field
            hint_text: "Select subcounty"
            mode: "rectangle"
            readonly: True

    Widget:
        size_hint_y: 0.005

    # Display error messages
    Label:
        text: root.error_message
        color: 1, 0, 0, 1
        size_hint_y: None
        size_hint_x: 0.8
        height: 60
        text_size: self.size
        halign: "center"
        valign: "middle"
    
    # Send Button
    Button:
        id: send_button
        text: root.send_text
        size_hint: (0.5, None)
        height: 100
        pos_hint: {'center_x': 0.5}
        background_color: 0,0,0,0
        background_normal: ''
        on_press: 
            root.send_action()
        canvas.before:
            Color:
                rgba: (179/255, 156/255, 77/255, 1)
            RoundedRectangle:
                size: self.size
                pos: self.pos
                radius: [15]
    
    # Spacer
    Widget:
        size_hint_y: 0.005

    # Toggle between signup and login
    Button:
        id: toggle_mode_button
        background_color: 0,0,0,0
        color: 0, 0, 1, 1 # Blue link color
        text: root.secondary_text
        size_hint_y: None
        height: 40 if root.show_secondary else 0
        opacity: 1 if root.show_secondary else 0
        disabled: not root.show_secondary
        on_release:
            root.secondary_action()

    # Spacer
    Widget:
        size_hint_y: 0.005

<SignupPage>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            size: self.size
            pos: self.pos

    FloatLayout: 
        size: root.size
        pos: root.pos
        on_size: print("root size", self.size)
        canvas.before:
            Color:
                rgba: 1, 0, 0, 1

        # Card (centered)
        CardTemplate:
            id: signup_card
            # Toggle between login and signup
            is_login_mode: root.is_login_mode
            show_input_type: not root.is_login_mode
            show_subcounty: not root.is_login_mode
            show_secondary: True
            send_action: root.process_login if root.is_login_mode else root.process_signup
            secondary_action: root.toggle_mode
            open_subcounty_action: root.open_subcounty_menu
            error_message: root.error_message
            secondary_text:
                "Already have an account? Login here" if not root.is_login_mode \
                else "Don't have an account? Signup here"
            # Reuses the CardTemplate style

<CameraPopup@ModalView>:
    size_hint: 0.9, 0.9
    auto_dismiss: False
    BoxLayout:
        orientation: 'vertical'
        Preview:
            id: preview
        Button:
            text: "Take Photo"
            size_hint_y: 0.15
            on_press: root.do_capture()
        Button:
            text: "Close"
            size_hint_y: 0.1
            on_press: root.dismiss()

<AudioInputScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            size: self.size
            pos: self.pos

    BoxLayout:
        orientation: "vertical"
        size: root.size
        pos: root.pos
        size_hint_y: None

        # Green Horizontal Bar at the top
        BoxLayout:
            id: top_bar
            orientation: "horizontal"
            size_hint_y: None
            height: 100
            canvas.before:
                Color:
                    rgba: (96/255), (119/255), (68/255), 1 
                Rectangle:
                    size: self.size
                    pos: self.pos

            Widget:
                size_hint_x: 1

            Button:
                text: "Settings"
                size_hint_x: None
                width: 120
                background_color: 0,0,0,0
                on_press: app.root.current = "settings"

        RelativeLayout:
            size_hint: None, None
            size: 300, 300  # This defines the circular area
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            canvas.before:
                Color:
                    rgba: (96/255), (119/255), (68/255), 1
                Ellipse:
                    # Drawing at 0,0 relative to the parent RelativeLayout
                    pos: 0, 0
                    size: self.size

            # Controls audio recording and playback
            MDIconButton:
                id: record_audio
                icon: "microphone"
                font_size: "100sp"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                on_release: root.start_recording() if not root.is_recording else root.stop_recording()

            # Loading spinner animation
            MDSpinner:
                id: audio_spinner
                size_hint: None, None
                size: 60, 60
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                active: False
                opacity: 0

            Button:
                background_color: 0, 0, 0, 0
                size_hint: 1, 1
                on_release: root.start_recording() if not root.is_recording else root.stop_recording()

        Widget:
            size_hint_y: 1

        # Capture image for the audio page
        MDIconButton:
            icon: "camera"
            md_bg_color: (96/255), (119/255), (68/255), 1
            background_normal: ""
            size_hint: None, None
            size: 48, 48
            pos_hint: {'right': 1}
            on_release: root.capture_image()

<TextInputScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            size: self.size
            pos: self.pos

    BoxLayout:
        orientation: "vertical"
        size: root.size
        pos: root.pos

        # Green Horizontal Bar at the top
        BoxLayout:
            id: top_bar
            orientation: "horizontal"
            size_hint_y: None
            height: 100
            canvas.before:
                Color:
                    rgba: (96/255), (119/255), (68/255), 1 
                Rectangle:
                    size: self.size
                    pos: self.pos

            Widget:
                size_hint_x: 1

            # Button for navigating to the settings page
            Button:
                text: "Settings"
                size_hint_x: None
                width: 120
                background_color: 0,0,0,0
                on_press: app.root.current = "settings"

        RecycleView:
            MDList:
                id: chat_list # Holder for the chat bubble generated in main.py

        # Text input panel
        BoxLayout:
            id: input_panel
            orientation: "horizontal"
            size_hint_y: None
            height: 100
            padding: 10
            spacing: 10
            canvas.before:
                Color:
                    rgba: (240/255), (240/255), (240/255), 1 # Light grey background
                Rectangle:
                    size: self.size
                    pos: self.pos

            FocusTextInput:
                id: message_input
                hint_text: "Type your message here..."
                multiline: False
                size_hint_x: 0.8

            # Send text input to server button
            Button:
                id: send
                text: "Send"
                size_hint_x: 0.2
                background_color: 0,0,0,0
                canvas.before:
                    Color:
                        rgba: (179/255, 156/255, 77/255, 1)
                    RoundedRectangle:
                        size: self.size
                        pos: self.pos
                        radius: [10]
                on_press: root.send_message()

            # Image capture button
            MDIconButton:
                icon: "camera"
                md_bg_color: (96/255), (119/255), (68/255), 1
                background_normal: ""
                size_hint: None, None
                size: 48, 48
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                on_release: root.capture_image()

<SettingsPage>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            size: self.size
            pos: self.pos

    FloatLayout:
        size: root.size
        pos: root.pos

        # Green card
        CardTemplate:
            id: settings_card

            # Set the template to display components for the settings page
            is_login_mode: False
            show_input_type: True
            show_subcounty: True
            show_secondary: True
            send_action: root.save_settings
            secondary_action: root.go_back
            open_subcounty_action: root.open_subcounty_menu
            
            error_message: root.error_message
            username_label: "Enter Username:"
            password_label: "Password (leave blank to keep)"
            send_text: "SAVE"
            secondary_text: "Back"
